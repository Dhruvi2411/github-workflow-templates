pipeline {
    agent {
        label 'dhruvi-agent'
    }

    stages {
        stage('Check Kubernetes Cluster') {
            steps {
                sh '''
                    set -e

                    echo "Checking Minikube status..."

                    if ! minikube status; then
                        echo "Minikube is not running. Starting Minikube..."
                        minikube start --driver=docker
                    fi

                    echo "Updating Kubernetes context..."
                    minikube update-context

                    echo "Setting Kubernetes context..."
                    kubectl config use-context minikube

                    echo "Checking Kubernetes connectivity..."
                    kubectl cluster-info

                    echo "Checking Kubernetes nodes..."
                    kubectl get nodes --all-namespaces

                    echo "Waiting for Kubernetes nodes to be Ready..."
                    kubectl wait --for=condition=Ready nodes --all --timeout=120s

                    echo "Minikube cluster is ready!"
                '''
            }
        }

        stage('Check Kubernetes Connection') {
            steps {
                sh '''
                    echo "Checking kubectl..."
                    kubectl version --client

                    echo "Checking Minikube nodes..."
                    kubectl get pods --all-namespaces

                    echo "Checking deployments..."
                    kubectl get deployments
                '''
            }
        }

        stage('Verify GitHub Checkout') {
            steps {
                sh '''
                    echo "Current directory:"
                    pwd

                    echo "Repository files:"
                    ls -la

                    echo "Kubernetes YAML files:"
                    ls -la blue-green-k8s/
                '''
            }
        }

        stage('Validate Kubernetes YAML') {
            steps {
                sh '''
                    set -e

                    echo "Validating Blue Deployment..."
                    kubectl apply --dry-run=server \
                        -f blue-green-k8s/blue-deployment.yaml

                    echo "Validating Green Deployment..."
                    kubectl apply --dry-run=server \
                        -f blue-green-k8s/green-deployment.yaml

                    echo "Validating Kubernetes Service..."
                    kubectl apply --dry-run=server \
                        -f blue-green-k8s/service.yaml

                    echo "All Kubernetes YAML files validated successfully!"
                '''
            }
        }

        stage('Detect Active Environment') {
            steps {
                script {
                    env.ACTIVE_ENV = sh(
                        script: "kubectl get service shopping-service -o jsonpath='{.spec.selector.environment}'",
                        returnStdout: true
                    ).trim()

                    if (env.ACTIVE_ENV == 'blue') {
                        env.TARGET_ENV = 'green'
                    } else if (env.ACTIVE_ENV == 'green') {
                        env.TARGET_ENV = 'blue'
                    } else {
                        error("Unknown active environment: ${env.ACTIVE_ENV}")
                    }

                    env.TARGET_DEPLOYMENT = "${env.TARGET_ENV}-deployment"
                    env.TARGET_MANIFEST = "blue-green-k8s/${env.TARGET_ENV}-deployment.yaml"

                    echo "Currently active: ${env.ACTIVE_ENV}"
                    echo "Next deployment target: ${env.TARGET_ENV}"
                }
            }
        }
    }
}   