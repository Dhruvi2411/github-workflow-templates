pipeline {
    agent {
        label 'dhruvi-agent'
    }

    stages {
        stage('Check Kubernetes Cluster') {
            steps {
                sh '''
                    echo "Checking kubectl configuration..."
                    kubectl config current-context

                    echo "Checking Kubernetes cluster connectivity..."
                    kubectl cluster-info

                    echo "Checking Kubernetes nodes..."
                    kubectl get nodes

                    echo "Checking whether all nodes are Ready..."
                    kubectl wait --for=condition=Ready nodes --all --timeout=60s

                    echo "Kubernetes cluster is accessible and nodes are Ready."
                '''
            }
        }
        
        stage('Check Kubernetes Connection') {
            steps {
                sh '''
                    echo "Checking kubectl..."
                    kubectl version --client

                    echo "Checking Minikube nodes..."
                    kubectl get nodes

                    echo "Checking deployments..."
                    kubectl get deployments
                '''
            }
        }

        stage('Verify GitHub Checkout') {
            steps {
                sh '''
                    echo "Current directory:"
                    pwd

                    echo "Repository files:"
                    ls -la

                    echo "Kubernetes YAML files:"
                    ls -la blue-green-k8s/
                '''
            }
        }
    }
}