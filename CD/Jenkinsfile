pipeline {
    agent {
        label 'dhruvi-agent'
    }

    stages {
        stage('Check Kubernetes Cluster') {
            steps {
                sh '''
                    set -e

                    echo "Checking Minikube status..."

                    if ! minikube status; then
                        echo "Minikube is not running. Starting Minikube..."
                        minikube start --driver=docker
                    fi

                    echo "Updating Kubernetes context..."
                    minikube update-context

                    echo "Setting Kubernetes context..."
                    kubectl config use-context minikube

                    echo "Checking Kubernetes connectivity..."
                    kubectl cluster-info

                    echo "Checking Kubernetes nodes..."
                    kubectl get nodes --all-namespaces

                    echo "Waiting for Kubernetes nodes to be Ready..."
                    kubectl wait --for=condition=Ready nodes --all --timeout=120s

                    echo "Minikube cluster is ready!"
                '''
            }
        }

        stage('Check Kubernetes Connection') {
            steps {
                sh '''
                    echo "Checking kubectl..."
                    kubectl version --client

                    echo "Checking Minikube nodes..."
                    kubectl get pods --all-namespaces

                    echo "Checking deployments..."
                    kubectl get deployments
                '''
            }
        }

        stage('Verify GitHub Checkout') {
            steps {
                sh '''
                    echo "Current directory:"
                    pwd

                    echo "Repository files:"
                    ls -la

                    echo "Kubernetes YAML files:"
                    ls -la blue-green-k8s/
                '''
            }
        }

        stage('Validate Kubernetes YAML') {
            steps {
                sh '''
                    set -e

                    echo "Validating Blue Deployment..."
                    kubectl apply --dry-run=server \
                        -f blue-green-k8s/blue-deployment.yaml

                    echo "Validating Green Deployment..."
                    kubectl apply --dry-run=server \
                        -f blue-green-k8s/green-deployment.yaml

                    echo "Validating Kubernetes Service..."
                    kubectl apply --dry-run=server \
                        -f blue-green-k8s/service.yaml

                    echo "All Kubernetes YAML files validated successfully!"
                '''
            }
        }


        stage('Detect Active Environment') {
            steps {
                script {
                    def serviceExists = sh(
                        script: "kubectl get service shopping-service",
                        returnStatus: true
                    )

                    if (serviceExists != 0) {
                        echo "First deployment detected!"

                        env.FIRST_DEPLOYMENT = 'true'
                        env.ACTIVE_ENV = 'none'
                        env.TARGET_ENV = 'blue'

                    } else {
                        echo "Existing deployment detected!"

                        env.FIRST_DEPLOYMENT = 'false'

                        env.ACTIVE_ENV = sh(
                            script: "kubectl get service shopping-service -o jsonpath='{.spec.selector.environment}'",
                            returnStdout: true
                        ).trim()

                        if (env.ACTIVE_ENV == 'blue') {
                            env.TARGET_ENV = 'green'
                        } else if (env.ACTIVE_ENV == 'green') {
                            env.TARGET_ENV = 'blue'
                        } else {
                            error("Unknown environment: ${env.ACTIVE_ENV}")
                        }
                    }

                    env.TARGET_DEPLOYMENT = "${env.TARGET_ENV}-deployment"
                    env.TARGET_MANIFEST = "blue-green-k8s/${env.TARGET_ENV}-deployment.yaml"

                    echo "First Deployment: ${env.FIRST_DEPLOYMENT}"
                    echo "Active: ${env.ACTIVE_ENV}"
                    echo "Target: ${env.TARGET_ENV}"
                }
            }
        }


        stage('Deploy and Test Inactive Environment') {
            steps {
                sh '''
                    set -e

                    echo "Deploying to inactive environment..."
                    kubectl apply -f "$TARGET_MANIFEST"

                    kubectl rollout status \
                        "deployment/$TARGET_DEPLOYMENT" \
                        --timeout=120s

                    echo "Starting port-forward..."

                    kubectl port-forward \
                        "deployment/$TARGET_DEPLOYMENT" \
                        18081:80 \
                        > /tmp/blue-green-port-forward.log 2>&1 &

                    PF_PID=$!

                    trap 'kill "$PF_PID" 2>/dev/null || true' EXIT

                    HEALTHY=false

                    for i in $(seq 1 15); do
                        echo "Health check attempt: $i"

                        if curl -fsS \
                            --connect-timeout 2 \
                            --max-time 5 \
                            http://127.0.0.1:18081/ \
                            -o /dev/null; then

                            HEALTHY=true
                            echo "SUCCESS: Target environment is healthy!"
                            break
                        fi

                        echo "Connection failed. Retrying..."
                        sleep 2
                    done

                    if [ "$HEALTHY" != "true" ]; then
                        echo "ERROR: All 15 health checks failed!"

                        echo "Port-forward logs:"
                        cat /tmp/blue-green-port-forward.log

                        exit 1
                    fi

                    echo "Health verification completed successfully."
                '''
            }
        }


        stage('Switch Traffic and Verify') {
            steps {
                script {
                    def previous = env.ACTIVE_ENV
                    def target = env.TARGET_ENV
                    def firstDeployment = (env.FIRST_DEPLOYMENT == 'true')

                    try {
                        if (firstDeployment) {
                            echo "First deployment detected!"
                            echo "Creating Service for ${target}..."

                            sh '''
                                set -e
                                kubectl apply -f blue-green-k8s/blue-deployment.yaml
                                kubectl apply -f blue-green-k8s/green-deployment.yaml

                                kubectl rollout status deployment/blue-deployment --timeout=120s
                                kubectl rollout status deployment/green-deployment --timeout=120s

                                kubectl apply -f blue-green-k8s/service.yaml
                            '''
                        }

                        withEnv(["PATCH_ENV=${target}"]) {
                            sh '''
                                set -e

                                echo "Switching traffic to $PATCH_ENV..."

                                kubectl patch service shopping-service \
                                    --type=merge \
                                    -p '{"spec":{"selector":{"app":"shopping","environment":"'"$PATCH_ENV"'"}}}'

                                echo "Checking Service selector..."
                                kubectl get service shopping-service \
                                    -o jsonpath='{.spec.selector}'
                                echo ""

                                echo "Waiting for ready Service endpoints..."

                                READY=false

                                for i in $(seq 1 15); do
                                    ADDRESSES=$(kubectl get endpoints shopping-service \
                                        -o jsonpath='{.subsets[*].addresses[*].ip}')

                                    if [ -n "$ADDRESSES" ]; then
                                        READY=true
                                        echo "Ready endpoints: $ADDRESSES"
                                        break
                                    fi

                                    echo "Endpoints not ready. Retrying..."
                                    sleep 2
                                done

                                if [ "$READY" != "true" ]; then
                                    echo "ERROR: No ready endpoints found!"
                                    exit 1
                                fi

                                echo "Testing live application traffic..."

                                HEALTHY=false

                                for i in $(seq 1 10); do
                                    if curl -fsS \
                                        --connect-timeout 2 \
                                        --max-time 5 \
                                        "http://$(minikube ip):30081/" \
                                        -o /dev/null; then

                                        HEALTHY=true
                                        echo "Application is responding!"
                                        break
                                    fi

                                    echo "Health check failed. Retrying..."
                                    sleep 2
                                done

                                if [ "$HEALTHY" != "true" ]; then
                                    echo "ERROR: Live traffic verification failed!"
                                    exit 1
                                fi

                                echo "SUCCESS: $PATCH_ENV is now active!"
                            '''
                        }

                    } catch (err) {
                        echo "Traffic switching or verification failed!"

                        if (!firstDeployment && previous in ['blue', 'green']) {
                            echo "Rolling back to ${previous}..."

                            withEnv(["PATCH_ENV=${previous}"]) {
                                sh '''
                                    set -e

                                    kubectl patch service shopping-service \
                                        --type=merge \
                                        -p '{"spec":{"selector":{"app":"shopping","environment":"'"$PATCH_ENV"'"}}}'

                                    echo "Checking Service after rollback..."
                                    kubectl get service shopping-service \
                                        -o jsonpath='{.spec.selector}'
                                    echo ""

                                    kubectl get endpoints shopping-service
                                '''
                            }
                            echo "Rollback command completed."
                        } else {
                            echo "No previous environment to restore."
                            echo "First deployment requires investigation."
                        }

                        throw err
                    }
                }
            }
        }

        stage('Final Deployment Verification') {
            steps {
                sh '''
                    set -e

                    echo "Active environment: $TARGET_ENV"

                    kubectl get pods -l app=shopping -o wide

                    echo "Checking Service selector..."
                    kubectl get service shopping-service \
                        -o jsonpath='{.spec.selector}'
                    echo ""

                    echo "Checking Service endpoints..."
                    kubectl get endpoints shopping-service

                    echo "Testing application response..."
                    curl -fsS "http://$(minikube ip):30080/" -o /dev/null

                    echo "SUCCESS: Final deployment verification completed!"
                '''
            }
        }
    }
}   